# Open default USB ADB for mainline Linux 7.3 bringup.
# Do NOT start adbd in early-init before init.qcom.usb.rc mounts /dev/usb-ffs/adb,
# or adbd fails to bind FunctionFS and /config/usb_gadget/g1/UDC stays empty.

on post-fs-data
    setprop persist.sys.usb.config adb

on property:sys.usb.configfs=1 && property:sys.usb.config=none
    setprop sys.usb.config adb
